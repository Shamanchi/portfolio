{
  "name": "p08-2048-game-eks",
  "version": "1.0.0",
  "private": true,
  "description": "Traditional 2048 game logic in pure TypeScript with a terminal CLI, plus Kubernetes manifests to run the game on EKS.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "cli": "node src/cli.ts",
    "manifests": "node src/cli.ts --manifests"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
