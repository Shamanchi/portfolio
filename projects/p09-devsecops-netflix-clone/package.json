{
  "name": "p09-devsecops-netflix-clone",
  "version": "1.0.0",
  "private": true,
  "description": "Original watch-catalog demo app with a security-first pipeline: lightweight SAST, dependency audit, secrets scan and a rendered GitHub Actions workflow.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "cli": "node src/cli.ts",
    "check": "node src/cli.ts --check",
    "audit": "npm audit --audit-level=high",
    "serve": "node src/cli.ts --serve 8080"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}
