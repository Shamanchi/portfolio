{
  "name": "p12-super-mario-k8s",
  "version": "1.0.0",
  "private": true,
  "description": "Original side-scrolling runner game with a headless engine and Kubernetes delivery: manifests, HTTP demo server and Dockerfile.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "cli": "node src/cli.ts",
    "check": "node src/cli.ts --check",
    "serve": "node src/cli.ts --serve 8080"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "typescript": "^7.0.2"
  }
}